// trips_query — the bombshell.
// 200k taxi-ish rows, generated deterministically (same LCG as the C/C++/
// Rust/Python versions), then: join zones→boroughs, group by (borough, pay),
// aggregate, HAVING-filter on avg fare, tip-share column, sort by revenue.

use std::polars::*;

const N = 200000;
const BOROUGHS = ["Manhattan", "Brooklyn", "Queens", "Bronx", "Staten Island"];

// ---- dataset generation (LCG, mod 2^31 — identical in every language) ----
let s = 42;
let rows = [];
for i in N {
    s = (1103515245 * s + 12345) % 2147483648;
    let zone = 1 + s % 265;
    s = (1103515245 * s + 12345) % 2147483648;
    let pay = 1 + s % 4;
    s = (1103515245 * s + 12345) % 2147483648;
    let dist_c = 50 + s % 2000;
    s = (1103515245 * s + 12345) % 2147483648;
    let fare_c = 500 + s % 4500;
    s = (1103515245 * s + 12345) % 2147483648;
    let tip_c = s % 3000;
    s = (1103515245 * s + 12345) % 2147483648;
    let hour = s % 24;
    rows.push(f"{zone},{pay},{(dist_c/100.0).format(2)},{(fare_c/100.0).format(2)},{(tip_c/100.0).format(2)},{hour}");
}
let zrows = [];
for z in 265 {
    zrows.push(f"{z + 1},{BOROUGHS[z % 5]}");
}
let trips = from_csv("zone,pay,dist,fare,tip,hour\n" + rows.join("\n"))!;
let zones = from_csv("zone,borough\n" + zrows.join("\n"))!;

// ---- the query ----
let result = query {
    trips
    join zones zone
    group borough pay {
        aggregate {
            trips = count(),
            revenue = sum(fare),
            tips = sum(tip),
            avg_fare = mean(fare),
        }
    }
    filter avg_fare > 15
    derive tip_share = tips / sum(tips)
    sort -revenue
};

// ---- checksum-shaped output (identical across all five languages) ----
let b: [str] = result.pull("borough")!;
let p: [int] = result.pull("pay")!;
let n: [int] = result.pull("trips")!;
let r: [float] = result.pull("revenue")!;
let a: [float] = result.pull("avg_fare")!;
let t: [float] = result.pull("tips")!;
let sh: [float] = result.pull("tip_share")!;
for i in b.len() {
    print(f"{b[i]}|{p[i]}|{n[i]}|{r[i].format(2)}|{a[i].format(2)}|{t[i].format(2)}|{sh[i].format(4)}");
}
