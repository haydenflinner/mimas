// trips_gen — baseline for trips_query: generation only, no query.
// The doc's "query phase" column is `trips_query − trips_gen`.

use std::polars::*;

const N = 200000;
const BOROUGHS = ["Manhattan", "Brooklyn", "Queens", "Bronx", "Staten Island"];

let s = 42;
let rows = [];
for i in N {
    s = (1103515245 * s + 12345) mod 2147483648;
    let zone = 1 + s mod 265;
    s = (1103515245 * s + 12345) mod 2147483648;
    let pay = 1 + s mod 4;
    s = (1103515245 * s + 12345) mod 2147483648;
    let dist_c = 50 + s mod 2000;
    s = (1103515245 * s + 12345) mod 2147483648;
    let fare_c = 500 + s mod 4500;
    s = (1103515245 * s + 12345) mod 2147483648;
    let tip_c = s mod 3000;
    s = (1103515245 * s + 12345) mod 2147483648;
    let hour = s mod 24;
    rows.push(f"{zone},{pay},{(dist_c/100.0).format(2)},{(fare_c/100.0).format(2)},{(tip_c/100.0).format(2)},{hour}");
}
let zrows = [];
for z in 265 {
    zrows.push(f"{z + 1},{BOROUGHS[z mod 5]}");
}
let trips = from_csv("zone,pay,dist,fare,tip,hour\n" + rows.join("\n"))!;
let zones = from_csv("zone,borough\n" + zrows.join("\n"))!;
print(trips.pull("zone")!.len() + zones.pull("zone")!.len());
