enum Dir { N, S, E, W }

fn delta(d: Dir) -> int {
    match d {
        Dir::N => 1,
        Dir::S => 0 - 1,
        Dir::E => 10,
        Dir::W => 0 - 10,
    }
}

fn risky(ok: bool) -> int! {
    if ok { 42 } else { raise "nope" }
}

struct Wide { a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int, j: int }

let arr = [10, 20, 30];
arr[0] = 5;
let d = ~{ k = 9 };
d["j"] = 4;
let deep = [[1, 2], [3, 4]];
let wide = Wide { a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8, i = 9, j = 10 };
let collected = for x in [1, 2, 3] collect x * 2;
let ok = risky(true) absolve |_| 0;
let failed = risky(false) absolve |_| 99;
let hits = 0;
if 20 in arr { hits += 1; }
if 99 in arr { hits += 100; }
if "k" in d { hits += 10; }
hits += delta(Dir::E) + delta(Dir::S) + arr[0] + arr[1] mod 7 + wide.j + d["j"]! + deep[1][1];
keep(failed);
keep(collected);
let TEST_VALUE = f"{hits}:{ok}:{5 mod 3}";
