// The built-in source every program has (solve::BUILTIN_SRC): declarations
// only, so a program built without std has it too. `Opp` is the pact an
// `opp` declaration implements -- two ends and a flip: `!x` is `x.inv()`,
// the other end, and `!(!x) == x`. `bool` is the first opp (its `!` stays
// the built-in op); the rest are the pairs pages kept spelling as bools or ±1, so
// `LightDark::Dark` on one page means what it means on the next.

pact Opp {
    fn inv(self) -> Self;
    /// The one-character picture this end draws with -- the opp switch
    /// and the dial label their ends by it. `""` means "use the name".
    /// `opp Sky { Sun "☀", Moon "☾" }` fills it in.
    fn glyph(self) -> str { let _end = self; "" }
}

// `bool` is the first opp: `!b` stays the built-in op; the impl lets a bool
// go wherever an `Opp` is expected (`involutive(true)`).
impl Opp for bool {
    fn inv(self) -> bool { !self }
    fn glyph(self) -> str { if self { "✓" } else { "✗" } }
}

// An ordered quantity is an axis too: its flip is its negation (a `px`
// is a float). These serve static calls -- a space's flip calls a number
// field's `inv` -- a number doesn't travel as an `Opp`-typed value.
impl Opp for int {
    fn inv(self) -> int { -self }
}
impl Opp for float {
    fn inv(self) -> float { -self }
}
opp PosNeg { Pos "➕", Neg "➖" }
opp LightDark { Light "☀", Dark "☾" }
opp DayNight { Day "🌞", Night "🌙" }
opp AscDesc { Asc "↗", Desc "↘" }
opp BigSmall { Big "⬤", Small "●" }
opp StartEnd { Start "⇤", End "⇥" }


// Reflection: what the macros `sig!`, `fns!`, `fields!` and `variants!`
// answer with (`parse::parser::reflect`). A type is text, as it was
// written in the declaration.

/// One parameter of a function.
struct FnParam { name: str, ty: str }

/// A function as data: its name, its parameters, its return type, its
/// doc comment on one line, and the marks (`#[machine]`) it carries.
struct FnSig { name: str, params: [FnParam], ret: str, doc: str, marks: [str] }

/// One field of a struct, or of an enum variant. A variant written
/// `Num(float)` has the field names `0`, `1`, ….
struct StructField { name: str, ty: str }

/// One variant of an enum.
struct EnumVariant { name: str, fields: [StructField] }
