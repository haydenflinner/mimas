//! The protocols a type joins so the language's own forms work on it.
//! `Show` is how `print` and an f-string write a value, and `Ord` is how
//! `<`, `<=`, `>` and `>=` compare one. A user type joins with an `impl`,
//! the same way the built-in types below do. `Iter` is how `for x in v`
//! and the combinators walk a value: its `type Item` names what each step
//! gives, and each impl fixes it. `Add`, `Sub`, `Mul`, `Div`, `Rem` and
//! `Neg` are the operators: `a + b` is `a.add(b)` through `Add`.

/// How a value writes itself: `print(v)` and `f"{v}"` call `show` when the
/// value's type implements `Show`.
pact Show {
    fn show(self) -> str;
}

/// A walk over a value, one step at a time. `iter` answers a pull: each
/// call gives the next item, then `null` when the walk is done. `for x in
/// v` walks any `Iter`, and so do `map`, `filter` and the other
/// combinators. r[impl mimas.std.iter]
pact Iter {
    type Item;
    fn iter(self) -> () -> Item?;

    // The combinators, lazy where they answer a walk: each pulls from
    // `iter` only when its own pull is called. A list keeps its own
    // `map`, `filter` and `fold`, which answer lists.
    // r[impl mimas.iter.pact-combinators]

    /// A pull over `f(x)` for each item.
    fn map<U>(self, f: (Item) -> U) -> () -> U? { __pull_map(self.iter(), f) }
    /// A pull over the items `p` keeps.
    fn filter(self, p: (Item) -> bool) -> () -> Item? { __pull_filter(self.iter(), p) }
    /// `f(f(init, x0), x1) …` over every item.
    fn fold<A>(self, init: A, f: (A, Item) -> A) -> A { __pull_fold(self.iter(), init, f) }
    /// The first item `p` keeps, or `null`.
    fn find(self, p: (Item) -> bool) -> Item? { __pull_find(self.iter(), p) }
    /// Whether `p` keeps any item.
    fn any(self, p: (Item) -> bool) -> bool { __pull_any(self.iter(), p) }
    /// Whether `p` keeps every item.
    fn all(self, p: (Item) -> bool) -> bool { __pull_all(self.iter(), p) }
    /// A pull over `(i, x)`, counting from 0.
    fn enumerate(self) -> () -> (int, Item)? { __pull_enumerate(self.iter()) }
    /// A pull over pairs, one from each walk, until either ends.
    fn zip<O: Iter>(self, o: O) -> () -> (Item, O::Item)? { __pull_zip(self.iter(), o.iter()) }
    /// A pull over every item of each `f(x)`.
    fn flat_map<U>(self, f: (Item) -> [U]) -> () -> U? { __pull_flat_map(self.iter(), f) }
    /// The items as a list.
    fn to_list(self) -> [Item] { __pull_to_list(self.iter()) }
}

// The built-in shapes walk the way `for` walks them, so a list, a `str`
// or a dict meets a `T: Iter` bound. A `for` over one keeps its own loop.
// r[impl mimas.std.iter.builtin]

impl Iter for [T] {
    type Item = T;
    /// A pull over the items, first to last.
    fn iter(self) -> () -> T? { __list_pull(self) }
}

impl Iter for str {
    type Item = str;
    /// A pull over the characters, each a one-character `str`.
    fn iter(self) -> () -> str? { __list_pull(self.chars()) }
}

impl Iter for {K: V} {
    type Item = (K, V);
    /// A pull over the `(key, value)` pairs, in the order they came.
    fn iter(self) -> () -> (K, V)? { __list_pull(self.pairs()) }
}

/// A total order. `cmp` answers a negative number, zero or a positive
/// number. `<`, `<=`, `>` and `>=` on a type that implements `Ord` and has
/// no `lt` compare through it.
pact Ord {
    fn cmp(self, o: Self) -> int;
}

impl Ord for int {
    fn cmp(self, o: int) -> int { if self < o { -1 } else if self > o { 1 } else { 0 } }
}

impl Ord for float {
    fn cmp(self, o: float) -> int { if self < o { -1 } else if self > o { 1 } else { 0 } }
}

impl Ord for str {
    fn cmp(self, o: str) -> int { if self < o { -1 } else if self > o { 1 } else { 0 } }
}

// Sorting and picking over `Ord` (L5). `xs.sorted()`, `xs.max()` and
// `xs.min()` on a list of a type that implements `Ord` call these, and so
// do `sorted_by`, `max_by` and `min_by` on any list. A native cannot call
// back into a `cmp` written in Nina, so the list forms live here.

fn __merge_by_keys<K: Ord>(keys: [K], a: [int], b: [int]) -> [int] {
    let out: [int] = [];
    let i = 0;
    let j = 0;
    while i < a.len() && j < b.len() {
        if keys[b[j]].cmp(keys[a[i]]) < 0 {
            out.push(b[j]);
            j += 1;
        } else {
            out.push(a[i]);
            i += 1;
        }
    }
    while i < a.len() { out.push(a[i]); i += 1; }
    while j < b.len() { out.push(b[j]); j += 1; }
    out
}

/// The positions of `keys` in ascending order, equal keys in their order.
fn __order_of<K: Ord>(keys: [K], idx: [int]) -> [int] {
    if idx.len() <= 1 { return idx; }
    let mid = idx.len() ~/ 2;
    let left: [int] = [];
    let right: [int] = [];
    for (n, i) in idx.enumerate() { if n < mid { left.push(i); } else { right.push(i); } }
    __merge_by_keys(keys, __order_of(keys, left), __order_of(keys, right))
}

fn __positions(n: int) -> [int] {
    let out: [int] = [];
    let i = 0;
    while i < n { out.push(i); i += 1; }
    out
}

/// A sorted copy, smallest first by `cmp`; equal items keep their order.
fn __sorted_ord<T: Ord>(xs: [T]) -> [T] {
    let out: [T] = [];
    for i in __order_of(xs, __positions(xs.len())) { out.push(xs[i]); }
    out
}

/// A copy sorted by `key(x)`, smallest key first; equal keys keep their order.
fn __sorted_by<T, K: Ord>(xs: [T], key: (T) -> K) -> [T] {
    let keys: [K] = [];
    for x in xs { keys.push(key(x)); }
    let out: [T] = [];
    for i in __order_of(keys, __positions(xs.len())) { out.push(xs[i]); }
    out
}

/// The largest item by `cmp`, the first of equals; `null` for an empty list.
fn __max_ord<T: Ord>(xs: [T]) -> T? {
    if xs.len() == 0 { return null; }
    let best = xs[0];
    for x in xs { if x.cmp(best) > 0 { best = x; } }
    best
}

/// The smallest item by `cmp`, the first of equals; `null` for an empty list.
fn __min_ord<T: Ord>(xs: [T]) -> T? {
    if xs.len() == 0 { return null; }
    let best = xs[0];
    for x in xs { if x.cmp(best) < 0 { best = x; } }
    best
}

/// The item with the largest `key(x)`, the first of equals; `null` if empty.
fn __max_by<T, K: Ord>(xs: [T], key: (T) -> K) -> T? {
    if xs.len() == 0 { return null; }
    let best = xs[0];
    let top = key(best);
    for x in xs {
        let k = key(x);
        if k.cmp(top) > 0 { best = x; top = k; }
    }
    best
}

/// The item with the smallest `key(x)`, the first of equals; `null` if empty.
fn __min_by<T, K: Ord>(xs: [T], key: (T) -> K) -> T? {
    if xs.len() == 0 { return null; }
    let best = xs[0];
    let low = key(best);
    for x in xs {
        let k = key(x);
        if k.cmp(low) < 0 { best = x; low = k; }
    }
    best
}

// Combinators over anything that iterates (L6). `g.map(f)` on a pull
// (`() -> T?`), or on a value whose type has `iter()` and no `map` of its
// own, calls these. A list keeps its own fast `map`, `filter` and `fold`.

/// A pull over the items of a list, first to last.
fn __list_pull<T>(xs: [T]) -> () -> T? {
    let at = [0];
    || -> T? {
        if at[0] < xs.len() {
            let v = xs[at[0]];
            at[0] += 1;
            v
        } else {
            null
        }
    }
}

fn __pull_map<T, U>(g: () -> T?, f: (T) -> U) -> () -> U? {
    || -> U? {
        let x = g();
        if x == null { null } else { f(x!) }
    }
}

fn __pull_filter<T>(g: () -> T?, p: (T) -> bool) -> () -> T? {
    || -> T? {
        loop {
            let x = g();
            if x == null { return null; }
            if p(x!) { return x; }
        }
    }
}

fn __pull_fold<T, A>(g: () -> T?, init: A, f: (A, T) -> A) -> A {
    let acc = init;
    for x in g { acc = f(acc, x); }
    acc
}

fn __pull_find<T>(g: () -> T?, p: (T) -> bool) -> T? {
    for x in g { if p(x) { return x; } }
    null
}

fn __pull_any<T>(g: () -> T?, p: (T) -> bool) -> bool {
    for x in g { if p(x) { return true; } }
    false
}

fn __pull_all<T>(g: () -> T?, p: (T) -> bool) -> bool {
    for x in g { if !p(x) { return false; } }
    true
}

fn __pull_enumerate<T>(g: () -> T?) -> () -> (int, T)? {
    let n = [0];
    || -> (int, T)? {
        let x = g();
        if x == null {
            null
        } else {
            let i = n[0];
            n[0] += 1;
            (i, x!)
        }
    }
}

fn __pull_zip<T, U>(g: () -> T?, h: () -> U?) -> () -> (T, U)? {
    || -> (T, U)? {
        let a = g();
        let b = h();
        if a == null || b == null { null } else { (a!, b!) }
    }
}

fn __pull_flat_map<T, U>(g: () -> T?, f: (T) -> [U]) -> () -> U? {
    let buf: [[U]] = [[]];
    let at = [0];
    || -> U? {
        loop {
            if at[0] < buf[0].len() {
                let v = buf[0][at[0]];
                at[0] += 1;
                return v;
            }
            let x = g();
            if x == null { return null; }
            buf[0] = f(x!);
            at[0] = 0;
        }
    }
}

/// The items left in a pull, as a list.
fn __pull_to_list<T>(g: () -> T?) -> [T] {
    let out: [T] = [];
    for x in g { out.push(x); }
    out
}

/// A copy of the list: `to_list()` is the one conversion, also on a list.
fn __list_to_list<T>(xs: [T]) -> [T] {
    let out: [T] = [];
    for x in xs { out.push(x); }
    out
}

// Ranges as values (L7): `0..5` outside a `for` head is a `Range`.

/// `a..b` as a value: the integers from `start` up to `end`, `end` left
/// out. `a..=b` is `Range { start: a, end: b + 1 }`. A `for` over `a..b`
/// keeps its own fast loop.
struct Range { start: int, end: int }

impl Iter for Range {
    type Item = int;
    /// A pull over the integers, smallest first.
    fn iter(self) -> () -> int? {
        let at = [self.start];
        let end = self.end;
        || -> int? {
            if at[0] < end {
                let v = at[0];
                at[0] += 1;
                v
            } else {
                null
            }
        }
    }
}

impl Range {
    /// How many integers the range holds.
    fn len(self) -> int { if self.end > self.start { self.end - self.start } else { 0 } }
    /// Whether `x` is in the range.
    fn contains(self, x: int) -> bool { x >= self.start && x < self.end }
}

fn __range(start: int, end: int, inclusive: bool) -> Range {
    Range { start, end: if inclusive { end + 1 } else { end } }
}

/// One shared, writable value: `let b = Cell { value: 100 }`. A closure
/// that captures `b` and writes `b.value -= amt` changes the one value
/// every holder of `b` sees, where a write to a captured plain `let` is
/// refused (it would change only that call's copy). The field is a place:
/// `+=`, `&b.value` and an `inout` argument work on it.
/// r[impl mimas.std.cell]
struct Cell<T> { value: T }


// ---- operators -----------------------------------------------------------
//
// `a + b` is `a.add(b)` through `Add<type of b>` on the type of `a`, and so
// for `-`, `*`, `/` and `mod`; `-a` is `Neg`. `Rhs` is the right operand's
// type, `Self` when left out, and `Out` is the result. A type may implement
// one operator several times with different `Rhs`: `Vec2 * Vec2` and
// `Vec2 * 2.0` are `impl Mul for Vec2` and `impl Mul<float> for Vec2`, and
// `2.0 * v` is `impl Mul<Vec2> for float`. A bound names the result:
// `fn sum<T: Add<Out = T>>(xs: [T]) -> T`. A type with only an inherent
// `add` still gets `+`. r[impl mimas.std.ops]

/// `a + b`.
pact Add<Rhs = Self> {
    type Out;
    fn add(self, o: Rhs) -> Out;
}

/// `a - b`.
pact Sub<Rhs = Self> {
    type Out;
    fn sub(self, o: Rhs) -> Out;
}

/// `a * b`.
pact Mul<Rhs = Self> {
    type Out;
    fn mul(self, o: Rhs) -> Out;
}

/// `a / b`.
pact Div<Rhs = Self> {
    type Out;
    fn div(self, o: Rhs) -> Out;
}

/// `a mod b`.
pact Rem<Rhs = Self> {
    type Out;
    fn rem(self, o: Rhs) -> Out;
}

/// `-a`.
pact Neg {
    type Out;
    fn neg(self) -> Out;
}

// The numbers' operators are built in: these impls declare no method, and
// the built-in operator answers, as fast as before. `int / int` is a
// `float`. r[impl mimas.op.pact-std]

impl Add for int { type Out = int; }
impl Sub for int { type Out = int; }
impl Mul for int { type Out = int; }
impl Div for int { type Out = float; }
impl Rem for int { type Out = int; }
impl Neg for int { type Out = int; }

impl Add for float { type Out = float; }
impl Sub for float { type Out = float; }
impl Mul for float { type Out = float; }
impl Div for float { type Out = float; }
impl Rem for float { type Out = float; }
impl Neg for float { type Out = float; }
