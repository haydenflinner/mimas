//! The protocols a type joins so the language's own forms work on it.
//! `Show` is how `print` and an f-string write a value, and `Ord` is how
//! `<`, `<=`, `>` and `>=` compare one. A user type joins with an `impl`,
//! the same way the built-in types below do. (`for x in v` walks any
//! value whose type has `fn iter(self) -> () -> T?`; a pact cannot name
//! the element type `T` yet, so that protocol has no pact of its own.)

/// How a value writes itself: `print(v)` and `f"{v}"` call `show` when the
/// value's type implements `Show`.
pact Show {
    fn show(self) -> str;
}

/// A total order. `cmp` answers a negative number, zero or a positive
/// number. `<`, `<=`, `>` and `>=` on a type that implements `Ord` and has
/// no `lt` compare through it.
pact Ord {
    fn cmp(self, o: Self) -> int;
}

impl Ord for int {
    fn cmp(self, o: int) -> int { if self < o { -1 } else if self > o { 1 } else { 0 } }
}

impl Ord for float {
    fn cmp(self, o: float) -> int { if self < o { -1 } else if self > o { 1 } else { 0 } }
}

impl Ord for str {
    fn cmp(self, o: str) -> int { if self < o { -1 } else if self > o { 1 } else { 0 } }
}

// Sorting and picking over `Ord` (L5). `xs.sorted()`, `xs.max()` and
// `xs.min()` on a list of a type that implements `Ord` call these, and so
// do `sorted_by`, `max_by` and `min_by` on any list. A native cannot call
// back into a `cmp` written in Nina, so the list forms live here.

fn __merge_by_keys<K: Ord>(keys: [K], a: [int], b: [int]) -> [int] {
    let out: [int] = [];
    let i = 0;
    let j = 0;
    while i < a.len() && j < b.len() {
        if keys[b[j]].cmp(keys[a[i]]) < 0 {
            out.push(b[j]);
            j += 1;
        } else {
            out.push(a[i]);
            i += 1;
        }
    }
    while i < a.len() { out.push(a[i]); i += 1; }
    while j < b.len() { out.push(b[j]); j += 1; }
    out
}

/// The positions of `keys` in ascending order, equal keys in their order.
fn __order_of<K: Ord>(keys: [K], idx: [int]) -> [int] {
    if idx.len() <= 1 { return idx; }
    let mid = idx.len() ~/ 2;
    let left: [int] = [];
    let right: [int] = [];
    for (n, i) in idx.enumerate() { if n < mid { left.push(i); } else { right.push(i); } }
    __merge_by_keys(keys, __order_of(keys, left), __order_of(keys, right))
}

fn __positions(n: int) -> [int] {
    let out: [int] = [];
    let i = 0;
    while i < n { out.push(i); i += 1; }
    out
}

/// A sorted copy, smallest first by `cmp`; equal items keep their order.
fn __sorted_ord<T: Ord>(xs: [T]) -> [T] {
    let out: [T] = [];
    for i in __order_of(xs, __positions(xs.len())) { out.push(xs[i]); }
    out
}

/// A copy sorted by `key(x)`, smallest key first; equal keys keep their order.
fn __sorted_by<T, K: Ord>(xs: [T], key: (T) -> K) -> [T] {
    let keys: [K] = [];
    for x in xs { keys.push(key(x)); }
    let out: [T] = [];
    for i in __order_of(keys, __positions(xs.len())) { out.push(xs[i]); }
    out
}

/// The largest item by `cmp`, the first of equals; `null` for an empty list.
fn __max_ord<T: Ord>(xs: [T]) -> T? {
    if xs.len() == 0 { return null; }
    let best = xs[0];
    for x in xs { if x.cmp(best) > 0 { best = x; } }
    best
}

/// The smallest item by `cmp`, the first of equals; `null` for an empty list.
fn __min_ord<T: Ord>(xs: [T]) -> T? {
    if xs.len() == 0 { return null; }
    let best = xs[0];
    for x in xs { if x.cmp(best) < 0 { best = x; } }
    best
}

/// The item with the largest `key(x)`, the first of equals; `null` if empty.
fn __max_by<T, K: Ord>(xs: [T], key: (T) -> K) -> T? {
    if xs.len() == 0 { return null; }
    let best = xs[0];
    let top = key(best);
    for x in xs {
        let k = key(x);
        if k.cmp(top) > 0 { best = x; top = k; }
    }
    best
}

/// The item with the smallest `key(x)`, the first of equals; `null` if empty.
fn __min_by<T, K: Ord>(xs: [T], key: (T) -> K) -> T? {
    if xs.len() == 0 { return null; }
    let best = xs[0];
    let low = key(best);
    for x in xs {
        let k = key(x);
        if k.cmp(low) < 0 { best = x; low = k; }
    }
    best
}

