// Z-set tables in the shared algebra (library::ZSET_SRC, shipped with
// std::polars). `Stream`, `stream`, `incremental` and the `AbelianGroup`
// pact live in `group.mim`; this file makes a table with weights one of
// the pact's groups, so a stream of Z-set tables runs the same stream
// operators as a stream of numbers.
// r[impl mimas.query.zset.stream]

use std::polars::DataFrame;

/// Z-set tables and weighted tables under `+`: the zero is the empty table
/// with the same columns, `x - x`. A table's `+`, `-` and `-x` are built in
/// and answer the pact's members. A plain table has no weights, so `+` on
/// one is the error that says to lift it with `query z { t }`.
/// r[impl mimas.group.pact]
impl Add for DataFrame { type Out = DataFrame; }
impl Sub for DataFrame { type Out = DataFrame; }
impl Neg for DataFrame { type Out = DataFrame; }
impl AbelianGroup for DataFrame {}

/// A few Z-sets, with removals, for the laws of `AbelianGroup`.
impl DataFrame {
    fn samples() -> [DataFrame] {
        [
            query z { table { item, w
                "apple", 2
                "bread", -1
            } },
            query z { table { item, w
                "apple", -1
                "fig", 3
            } },
            query z { table { item, w
                "bread", 1
            } },
        ]
    }
}

/// A tally as a Z-set table: the items in a column named `col`, at their
/// weights. The conversion is written out, since a tally lives in the VM
/// and a table in polars.
/// r[impl mimas.group.tally.table]
fn tally_table<T>(t: Tally<T>, col: str) -> DataFrame {
    let plain = __table_col(__table_col(__table_new(), col, t.items()), "w", t.pairs().map(|p: (T, int)| p.1));
    query z { plain }
}

/// `a ≈ b` on two weighted tables: the same rows, each weight equal to its
/// partner's within float rounding, the rule `float`'s `≈` uses. `==` on
/// weighted tables compares the weights exactly.
/// r[impl mimas.query.zset.approx]
impl Approx for DataFrame {
    fn approx(self, o: DataFrame) -> bool { __z_approx(self, o) }
}
