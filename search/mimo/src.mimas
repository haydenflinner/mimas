check coins().len() == 100
check solids().len() >= 10
check beatable()

cov::hit(592); cov::pass(593, game_loop(cov::pass(594, init()), tick, draw));


// img — the scene vocabulary. A page draws *values*: `game::draw`,
// `game::bounds`, the `live_*` fns, and the debugger's hover-draw all
// walk a returned tree into vector prims by reading each node's
// variant name (`Img::Rect` is the "rect" kind) and fields — so this
// enum is the checked spelling of that contract: a typo'd field or
// variant name is a compile error here, not a silent no-op. Include
// it with `use "img";`.
//
// `stroke = ""` means none. `Group`'s `at` translates its children
// (and is the only `at`-carrying node). The enum is the typed path,
// not the only one — a `~{kind = "…", …}` dict or your own
// identically-named struct walks the same way.
//
// Every geometric field is `px` — the renderer works in pixel space,
// so passing a quantity (or a bare literal suffixed `px`) is checked
// rather than silently rescaled. A `float` helper can put the unit
// on at the boundary with `v * 1.0px`.
enum Img {
    Rect { x: px, y: px, w: px, h: px, fill: str, stroke: str, stroke_w: px },
    Ellipse { x: px, y: px, w: px, h: px, fill: str, stroke: str, stroke_w: px },
    Line { x: px, y: px, x2: px, y2: px, stroke: str, stroke_w: px },
    Path { points: [[px]], closed: bool, fill: str, stroke: str, stroke_w: px },
    Text { x: px, y: px, text: str, size: px, fill: str },
    Prose { x: px, y: px, w: px, text: str },
    Group { at: [px], children: [Img] },
}

/// The debugger's draw pact: hover a value and the inspector calls its
/// `draw` for the scene — `impl Draw for W` makes that checked.
pact Draw {
    fn draw(self) -> [Img];
}


// game-kit — the shared scaffold for `use game` pages. Include it with
// `use "game-kit";` (the host splices this page's source in, like
// `use "img";`).
//
// Two things every game page kept repeating:
//   · the frame loop at the bottom — `game_loop`/`time_loop` say it once
//   · the palette — every page spelled the same hexes out by hand

// ---- the loop -------------------------------------------------------
//
// A game is three pieces: `init` makes the starting world, `tick`
// steps it on the frame's input and events, `draw` paints it. The
// loop that turns those into a running game is always the same — one
// `yield_frame` per pass until the host quits — so say it once and
// hand the pieces in: `game_loop(init(), tick, draw)`, or skip the
// init fn and pass the literal — `game_loop(W { t = 0.0 }, tick, draw)`.
// `W` is the game's own state type; generic, so the kit doesn't pin it.
// Note `tick` *gets* the frame's events — `game::events()` drains its
// queue on read, so take `evs` as a param rather than re-reading it.
fn game_loop<W>(world: W, tick: (W, Input, [Ev]) -> W, draw: (W) -> ()) {
    cov::hit(595); let w = world;
    cov::hit(596); while cov::dec(45, cov::begin(45) && (cov::cond(45, 0, !game::quitting()))) {
        cov::hit(597); w = cov::pass(598, tick(w, game::input(), game::events()));
        cov::hit(599); cov::pass(600, draw(w));
        cov::hit(601); game::yield_frame();
    }
}

// The animation flavor for pages that only need the frame's `dt`.
// NOT `game_loop` underneath — `game::events()` drains its queue when
// read, so fetching it here would starve a `tick` that reads events
// itself. Input snapshots are safe to double-read; events are not.
fn time_loop<W>(world: W, tick: (W, s) -> W, draw: (W) -> ()) {
    cov::hit(602); let w = world;
    cov::hit(603); while cov::dec(46, cov::begin(46) && (cov::cond(46, 0, !game::quitting()))) {
        cov::hit(604); w = cov::pass(605, tick(w, game::input().dt));
        cov::hit(606); cov::pass(607, draw(w));
        cov::hit(608); game::yield_frame();
    }
}

// ---- geometry -------------------------------------------------------
//
// `Rect<T>` is a plain positioned box, generic over the unit: `Rect<px>`
// is a screen-space region (hit tests, layout), but `Rect<inch>` in a
// carpentry spec or `Rect<float>` on a dimless field work the same way —
// the methods only need `T + T` and `T <= T`, which unify when every
// side is the same param. (Distinct units in one rect — `Rect{ x: px,
// w: inch }` — are a type error: the methods would be unsound.)
struct Rect<T> {
    x: T,
    y: T,
    w: T,
    h: T,
}
impl Rect {
    fn right(self) -> T { cov::hit(609); cov::pass(610, self.x) + cov::pass(611, self.w) }
    fn bottom(self) -> T { cov::hit(612); cov::pass(613, self.y) + cov::pass(614, self.h) }
    fn cx(self) -> float { cov::hit(615); (cov::pass(616, self.x) + cov::pass(617, self.x) + cov::pass(618, self.w)) / 2.0 }
    fn cy(self) -> float { cov::hit(619); (cov::pass(620, self.y) + cov::pass(621, self.y) + cov::pass(622, self.h)) / 2.0 }
    fn contains(self, x: T, y: T) -> bool {
        cov::hit(623); cov::dec(47, cov::begin(47) && (cov::cmp(47, 0, 3, cov::lhs(x) >= cov::rhs(cov::pass(624, self.x))) && cov::cmp(47, 1, 5, cov::lhs(x) <= cov::rhs(cov::pass(625, self.right()))) && cov::cmp(47, 2, 3, cov::lhs(y) >= cov::rhs(cov::pass(626, self.y))) && cov::cmp(47, 3, 5, cov::lhs(y) <= cov::rhs(cov::pass(627, self.bottom())))))
    }
    fn inflate(self, d: T) -> Rect<T> {
        cov::hit(628); Rect { x = cov::pass(629, cov::pass(630, self.x) - d), y = cov::pass(631, cov::pass(632, self.y) - d),
            w = cov::pass(633, cov::pass(634, self.w) + d + d), h = cov::pass(635, cov::pass(636, self.h) + d + d) }
    }
    fn move_to(self, x: T, y: T) -> Rect<T> {
        cov::hit(637); Rect { x = cov::pass(638, x), y = cov::pass(639, y), w = cov::pass(640, cov::pass(641, self.w)), h = cov::pass(642, cov::pass(643, self.h)) }
    }
    fn intersects(self, r: Rect<T>) -> bool {
        cov::hit(644); cov::dec(48, cov::begin(48) && (cov::cmp(48, 0, 4, cov::lhs(cov::pass(645, self.x)) < cov::rhs(cov::pass(646, r.right()))) && cov::cmp(48, 1, 4, cov::lhs(cov::pass(647, r.x)) < cov::rhs(cov::pass(648, self.right()))) && cov::cmp(48, 2, 4, cov::lhs(cov::pass(649, self.y)) < cov::rhs(cov::pass(650, r.bottom()))) && cov::cmp(48, 3, 4, cov::lhs(cov::pass(651, r.y)) < cov::rhs(cov::pass(652, self.bottom())))))
    }
}

// ---- the palette ----------------------------------------------------
// The slate ramp for surfaces and text (deep → ink), then the accent
// hues. `G_` keeps them out of the way of a game's own COLOR_* roles:
// name the role in your page, point it at the shared hue —
//     const COLOR_(LEFT, RIGHT) = (G_CYAN, G_PINK);
// A soft halo is the hue plus an alpha tail — `G_CYAN + "2a"`.
const G_(DEEP, BG, PANEL) = ("#0b1020", "#0f172a", "#1e293b");
const G_(EDGE, MID) = ("#334155", "#475569");
const G_(FAINT, DIM, INK) = ("#64748b", "#94a3b8", "#e2e8f0");
const G_WHITE = "#ffffff";
const G_(CYAN, SKY, BLUE) = ("#22d3ee", "#38bdf8", "#60a5fa");
const G_(VIOLET, PINK) = ("#a78bfa", "#f472b6");
const G_(RED, ROSE) = ("#f43f5e", "#f87171");
const G_(ORANGE, AMBER) = ("#f0a03c", "#fbbf24");
const G_(GOLD, YELLOW) = ("#facc15", "#fde047");
const G_GREEN = "#4ade80";
