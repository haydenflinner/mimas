use game;
use music;
use "img";
use "game-kit";

// Mimo — a literate platformer. The level is a [[#]] `level` data cell:
// one row per platform, coin, hazard, spawn and flag. This program reads
// it with `data("level")`, runs it as physics, and — because the level is
// data — *proves things about it*: `beatable()` below is a little solver
// that flood-fills every surface the jump physics can actually reach.
// `live_solve` paints that proof on the canvas every edit; `check
// beatable()` gates it. Drag a coin row's `y` out of reach and both go
// red in the same keystroke.
//
// `← →` run, `↑`/`space` jump, `r` restarts. Goombas walk, lava burns.
// Grab every coin, then touch the flag.

const FX = 40.0px;
const FY = 40.0px;
const FW = 960.0px;
const FH = 720.0px;

// §physics ------------------------------------------------------------
const GRAV = 1800.0px/s^2;
const JUMP_V = 560.0px/s;
const RUN = 300.0px/s;
const ACCEL = 2800.0px/s^2;
const TERM = 980.0px/s;
const PLAYER_W = 24.0px;
const PLAYER_H = 36.0px;

// §the level is data ---------------------------------------------------
// One row per feature: kind ∈ {ground, plat, coin, lava, goomba, goal,
// spawn}. The `level` data cell renders as the editable table on the
// canvas — dragging a row's numbers *is* editing the level.
struct LRow { id: str, kind: str, x: float, y: float, w: float, h: float }

fn level() -> [LRow] {
    // CSV ints arrive as `int` and `700 != 700.0` — `==` doesn't coerce.
    // Normalize the numeric fields to float once, at the boundary, so a
    // table full of integers can't poison the math below.
    cov::hit(1); let out: [LRow] = [];
    cov::hit(2); let r: [LRow] = cov::pass(3, data("level"))!.rows()!;
    cov::hit(4); for row in r {
        cov::hit(5); out.push(LRow { id = cov::pass(6, cov::pass(7, row.id)), kind = cov::pass(8, cov::pass(9, row.kind)),
            x = cov::pass(10, cov::pass(11, row.x) + 0.0), y = cov::pass(12, cov::pass(13, row.y) + 0.0), w = cov::pass(14, cov::pass(15, row.w) + 0.0), h = cov::pass(16, cov::pass(17, row.h) + 0.0) });
    }
    cov::hit(18); out
}
fn rows_of(k: str) -> [LRow] {
    cov::hit(19); let out: [LRow] = [];
    cov::hit(20); for r in cov::pass(21, level()) { cov::hit(22); if cov::dec(0, cov::begin(0) && (cov::cmp(0, 0, 0, cov::lhs(cov::pass(23, r.kind)) == cov::rhs(k)))) { cov::hit(24); out.push(r); } }
    cov::hit(25); out
}
fn solids() -> [LRow] {
    cov::hit(26); let out: [LRow] = [];
    cov::hit(27); for r in cov::pass(28, level()) {
        cov::hit(29); if cov::dec(1, cov::begin(1) && (cov::cmp(1, 0, 0, cov::lhs(cov::pass(30, r.kind)) == cov::rhs("plat")) || cov::cmp(1, 1, 0, cov::lhs(cov::pass(31, r.kind)) == cov::rhs("ground")))) { cov::hit(32); out.push(r); }
    }
    cov::hit(33); out
}
fn coins() -> [LRow] { cov::hit(34); cov::pass(35, rows_of("coin")) }
fn first_row(k: str) -> LRow! {
    cov::hit(36); for r in cov::pass(37, level()) { cov::hit(38); if cov::dec(2, cov::begin(2) && (cov::cmp(2, 0, 0, cov::lhs(cov::pass(39, r.kind)) == cov::rhs(k)))) { cov::hit(40); return r; } }
    cov::hit(41); raise "level has no '" + k + "' row";
}
fn spawn_row() -> LRow! { cov::hit(42); cov::pass(43, first_row("spawn")) }
fn goal_row() -> LRow! { cov::hit(44); cov::pass(45, first_row("goal")) }

// §the solver ----------------------------------------------------------
// A level is "beatable" when every coin and the flag is reachable by
// real jump arcs. Nodes are horizontal spans: a platform's top edge, a
// coin's grab box, the flag's base. An edge a→b exists when a jump (or
// falling drop) from anywhere on a can land on b — same numbers the
// physics below uses, no hand-tuned fudge. It is a *movement* proof:
// hazards are dodgeable, so the solver ignores them.
struct N { top: float, l: float, r: float, id: str }

const PICK = 18.0; // coin grab radius, px (float — solver math)

fn nodes() -> [N] {
    cov::hit(46); let out: [N] = [];
    cov::hit(47); for s in cov::pass(48, solids()) {
        cov::hit(49); out.push(N { top = cov::pass(50, cov::pass(51, s.y)), l = cov::pass(52, cov::pass(53, s.x)), r = cov::pass(54, cov::pass(55, s.x) + cov::pass(56, s.w)), id = cov::pass(57, cov::pass(58, s.id)) });
    }
    cov::hit(59); for c in cov::pass(60, coins()) {
        cov::hit(61); let cx = cov::pass(62, c.x) + cov::pass(63, c.w) / 2.0;
        cov::hit(64); let cy = cov::pass(65, c.y) + cov::pass(66, c.h) / 2.0;
        cov::hit(67); out.push(N { top = cov::pass(68, cy), l = cov::pass(69, cx - PICK), r = cov::pass(70, cx + PICK), id = cov::pass(71, cov::pass(72, c.id)) });
    }
    cov::hit(73); let g = cov::pass(74, goal_row())!;
    cov::hit(75); out.push(N { top = cov::pass(76, cov::pass(77, g.y) + cov::pass(78, g.h)), l = cov::pass(79, cov::pass(80, g.x) - 20.0), r = cov::pass(81, cov::pass(82, g.x) + cov::pass(83, g.w) + 20.0), id = cov::pass(84, cov::pass(85, g.id)) });
    cov::hit(86); out
}

// Longest flight from a's top to b's top: rising arc while dy ≤ apex,
// free drop below. Landing needs the falling branch, so take the + root.
fn can_jump(a: N, b: N) -> bool {
    cov::hit(87); let jv = JUMP_V.to("px/s");
    cov::hit(88); let g = GRAV.to("px/s^2");
    cov::hit(89); let run = RUN.to("px/s");
    cov::hit(90); let dy = cov::pass(91, a.top) - cov::pass(92, b.top);
    cov::hit(93); if cov::dec(3, cov::begin(3) && (cov::cmp(3, 0, 2, cov::lhs(dy) > cov::rhs(jv * jv / (2.0 * g))))) { cov::hit(94); return false; } // above jump apex
    cov::hit(95); let disc = jv * jv - 2.0 * g * dy;
    cov::hit(96); if cov::dec(4, cov::begin(4) && (cov::cmp(4, 0, 4, cov::lhs(disc) < cov::rhs(0.0)))) { cov::hit(97); return false; }
    cov::hit(98); let t = (jv + disc.sqrt()) / g;
    cov::hit(99); let gap = (cov::pass(100, b.l) - cov::pass(101, a.r)).max(cov::pass(102, a.l) - cov::pass(103, b.r)).max(0.0);
    cov::hit(104); gap + 4.0 <= run * t
}

fn reach() -> [str] {
    cov::hit(105); let ns = cov::pass(106, nodes());
    cov::hit(107); let s = cov::pass(108, spawn_row())!;
    cov::hit(109); let got: [str] = [];
    // the surface the spawn cell stands on seeds the flood
    cov::hit(110); for n in ns {
        cov::hit(111); if cov::dec(5, cov::begin(5) && (cov::cmp(5, 0, 3, cov::lhs(cov::pass(112, s.x) + 12.0) >= cov::rhs(cov::pass(113, n.l))) && cov::cmp(5, 1, 5, cov::lhs(cov::pass(114, s.x) + 12.0) <= cov::rhs(cov::pass(115, n.r))) && cov::cmp(5, 2, 4, cov::lhs((cov::pass(116, n.top) - cov::pass(117, s.y) - cov::pass(118, s.h)).abs()) < cov::rhs(4.0)))) {
            cov::hit(119); got.push(cov::pass(120, n.id));
        }
    }
    cov::hit(121); let grew = true;
    cov::hit(122); while cov::dec(6, cov::begin(6) && (cov::cond(6, 0, grew))) {
        cov::hit(123); grew = false;
        cov::hit(124); for a in ns {
            cov::hit(125); if cov::dec(7, cov::begin(7) && (cov::cond(7, 0, cov::pass(126, got.contains(cov::pass(127, a.id)))))) {
                cov::hit(128); for b in ns {
                    cov::hit(129); if cov::dec(8, cov::begin(8) && (cov::cond(8, 0, !cov::pass(130, got.contains(cov::pass(131, b.id)))) && cov::cond(8, 1, cov::pass(132, can_jump(a, b))))) {
                        cov::hit(133); got.push(cov::pass(134, b.id));
                        cov::hit(135); grew = true;
                    }
                }
            }
        }
    }
    cov::hit(136); got
}

// First thing a given flood can't reach — coin id, 'flag', or '' when
// the whole level clears. `blocker`/`live_solve` share one `reach()`.
fn blocker_of(got: [str]) -> str {
    cov::hit(137); for c in cov::pass(138, coins()) { cov::hit(139); if cov::dec(9, cov::begin(9) && (cov::cond(9, 0, !cov::pass(140, got.contains(cov::pass(141, c.id)))))) { cov::hit(142); return cov::pass(143, c.id); } }
    cov::hit(144); if cov::dec(10, cov::begin(10) && (cov::cond(10, 0, !cov::pass(145, got.contains("flag"))))) { cov::hit(146); return "flag"; }
    cov::hit(147); ""
}
fn blocker() -> str { cov::hit(148); cov::pass(149, blocker_of(cov::pass(150, reach()))) }
fn beatable() -> bool { cov::hit(151); cov::pass(152, blocker()) == "" }

// Which collectible the canvas points at: the blocker when there is
// one, else the 50th coin — the "watch" row of the table.
fn watch_id() -> str {
    cov::hit(153); let b = cov::pass(154, blocker());
    cov::hit(155); if cov::dec(11, cov::begin(11) && (cov::cmp(11, 0, 1, cov::lhs(b) != cov::rhs("")))) { cov::hit(156); b } else { cov::hit(157); "c050" }
}

fn show_watch() -> DataFrame! {
    cov::hit(158); cov::pass(159, data("level"))!.filter(col("id") == lit(cov::pass(160, watch_id())))
}

// The solver's readout — repaints on every edit. A verdict strip under
// the field (one dot per coin, reachable = gold, stuck = red) and a
// ring around the watch coin's spot *in the level*.
fn live_solve() -> [Img] {
    cov::hit(161); let got = cov::pass(162, reach());
    cov::hit(163); let b = cov::pass(164, blocker_of(got));
    cov::hit(165); let ok = b == "";
    cov::hit(166); let wid = if cov::dec(12, cov::begin(12) && (cov::cond(12, 0, ok))) { cov::hit(167); "c050" } else { cov::hit(168); b };
    cov::hit(169); let cs = cov::pass(170, coins());
    cov::hit(171); let parts: [Img] = [];
    cov::hit(172); let y0 = FY + FH + 30.0px;
    cov::hit(173); parts.push(Img::Text {
        x = cov::pass(174, FX), y = cov::pass(175, y0 + 26.0px), size = cov::pass(176, 22.0px),
        fill = cov::pass(177, if cov::dec(13, cov::begin(13) && (cov::cond(13, 0, ok))) { cov::hit(178); G_CYAN } else { cov::hit(179); G_RED }),
        text = cov::pass(180, if cov::dec(14, cov::begin(14) && (cov::cond(14, 0, ok))) {
            cov::hit(181); f"solver · {cs.len()}/{cs.len()} coins in jump range — level beatable ✓"
        } else {
            cov::hit(182); f"solver · {b} unreachable — level NOT beatable ✗"
        }),
    });
    // 10×10 dot grid — the whole table's reachability at a glance
    cov::hit(183); let i = 0;
    cov::hit(184); for c in cs {
        cov::hit(185); let gx = FX + 260.0px + (i mod 20).to_float() * 20.0px;
        cov::hit(186); let gy = y0 + 12.0px + (i / 20).floor() * 20.0px;
        cov::hit(187); let hot = cov::pass(188, c.id) == wid;
        cov::hit(189); parts.push(Img::Ellipse {
            x = cov::pass(190, gx), y = cov::pass(191, gy), w = cov::pass(192, 14.0px), h = cov::pass(193, 14.0px),
            fill = cov::pass(194, if cov::dec(15, cov::begin(15) && (cov::cond(15, 0, cov::pass(195, got.contains(cov::pass(196, c.id)))))) { cov::hit(197); G_GOLD } else { cov::hit(198); G_RED }),
            stroke = cov::pass(199, if cov::dec(16, cov::begin(16) && (cov::cond(16, 0, hot))) { cov::hit(200); G_WHITE } else { cov::hit(201); "" }),
            stroke_w = cov::pass(202, 2.0px),
        });
        cov::hit(203); i += 1;
    }
    // ring the watch coin where it sits in the level
    cov::hit(204); for c in cs {
        cov::hit(205); if cov::dec(17, cov::begin(17) && (cov::cmp(17, 0, 0, cov::lhs(cov::pass(206, c.id)) == cov::rhs(wid)))) {
            cov::hit(207); let cx = (cov::pass(208, c.x) + cov::pass(209, c.w) / 2.0) * 1.0px;
            cov::hit(210); let cy = (cov::pass(211, c.y) + cov::pass(212, c.h) / 2.0) * 1.0px;
            cov::hit(213); parts.push(Img::Ellipse {
                x = cov::pass(214, cx - 22.0px), y = cov::pass(215, cy - 22.0px), w = cov::pass(216, 44.0px), h = cov::pass(217, 44.0px),
                fill = cov::pass(218, ""), stroke = cov::pass(219, if cov::dec(18, cov::begin(18) && (cov::cond(18, 0, ok))) { cov::hit(220); G_CYAN } else { cov::hit(221); G_RED }),
                stroke_w = cov::pass(222, 3.0px),
            });
            cov::hit(223); parts.push(Img::Text {
                x = cov::pass(224, cx + 28.0px), y = cov::pass(225, cy + 6.0px), size = cov::pass(226, 16.0px),
                fill = cov::pass(227, if cov::dec(19, cov::begin(19) && (cov::cond(19, 0, ok))) { cov::hit(228); G_CYAN } else { cov::hit(229); G_RED }),
                text = cov::pass(230, f"{cov::pass(231, c.id)}"),
            });
        }
    }
    cov::hit(232); parts
}

// §sfx -----------------------------------------------------------------
fn sfxCoin() -> Voice {
    cov::hit(233); music::synth(0.0, 0.0, 0s, 0.05s, 1.0, 0.12s, 0Hz)
        .vol(0.4).freq(1320Hz).slide(0.4)
}
fn sfxJump() -> Voice {
    cov::hit(234); music::synth(0.0, 0.0, 0s, 0.03s, 1.0, 0.1s, 0Hz)
        .vol(0.35).freq(420Hz).slide(0.5)
}
fn sfxDie() -> Voice {
    cov::hit(235); music::synth(0.0, 0.0, 0s, 0.2s, 1.0, 0.3s, 0Hz)
        .vol(0.7).freq(220Hz).slide(-0.8).noise(0.4)
}
fn sfxWin() -> Voice {
    cov::hit(236); music::synth(0.0, 0.0, 0s, 0.3s, 1.0, 0.4s, 0Hz)
        .vol(0.6).jitter(0.1).freq(660Hz).slide(0.5)
}

// §the game ------------------------------------------------------------
struct W {
    px: px, py: px, vx: px/s, vy: px/s,
    face: float, grounded: bool,
    got: [str], score: int, deaths: int,
    won: bool, t: s,
}

fn init() -> W {
    cov::hit(237); let s = cov::pass(238, spawn_row())!;
    cov::hit(239); W { px = cov::pass(240, cov::pass(241, s.x) * 1.0px), py = cov::pass(242, cov::pass(243, s.y) * 1.0px), vx = cov::pass(244, 0.0px/s), vy = cov::pass(245, 0.0px/s),
        face = cov::pass(246, 1.0), grounded = cov::pass(247, false), got = cov::pass(248, []), score = cov::pass(249, 0), deaths = cov::pass(250, 0),
        won = cov::pass(251, false), t = cov::pass(252, 0.0s) }
}

// One-way platforms: you fall onto tops, never bump a side or a head —
// which is exactly the world the solver models.
fn tick(w: W, inp: Input, evs: [Ev]) -> W {
    cov::hit(253); if cov::dec(20, cov::begin(20) && (cov::cond(20, 0, cov::pass(254, inp.held.contains("r"))))) { cov::hit(255); return cov::pass(256, init()); }
    cov::hit(257); let dt = inp.dt;
    cov::hit(258); let px = cov::pass(259, w.px); cov::hit(260); let py = cov::pass(261, w.py);
    cov::hit(262); let vx = cov::pass(263, w.vx); cov::hit(264); let vy = cov::pass(265, w.vy);
    cov::hit(266); let grounded = cov::pass(267, w.grounded);
    cov::hit(268); let face = cov::pass(269, w.face);
    cov::hit(270); let t = cov::pass(271, w.t) + dt;

    // run
    cov::hit(272); if cov::dec(21, cov::begin(21) && (cov::cond(21, 0, cov::pass(273, inp.held.contains("arrowleft"))) || cov::cond(21, 1, cov::pass(274, inp.held.contains("a"))))) {
        cov::hit(275); vx = (vx - ACCEL * dt).max(-RUN); cov::hit(276); face = -1.0;
    } else if cov::dec(22, cov::begin(22) && (cov::cond(22, 0, cov::pass(277, inp.held.contains("arrowright"))) || cov::cond(22, 1, cov::pass(278, inp.held.contains("d"))))) {
        cov::hit(279); vx = (vx + ACCEL * dt).min(RUN); cov::hit(280); face = 1.0;
    } else {
        cov::hit(281); vx = vx * (1.0 - 10.0Hz * dt);
    }
    // jump
    cov::hit(282); if cov::dec(23, cov::begin(23) && (cov::cond(23, 0, grounded) && (cov::cond(23, 1, cov::pass(283, inp.held.contains("arrowup"))) || cov::cond(23, 2, cov::pass(284, inp.held.contains(" "))) || cov::cond(23, 3, cov::pass(285, inp.held.contains("w")))))) {
        cov::hit(286); vy = -JUMP_V; cov::hit(287); grounded = false;
        cov::hit(288); music::sfx(cov::pass(289, sfxJump()));
    }
    cov::hit(290); vy = (vy + GRAV * dt).min(TERM);

    // integrate + land on tops (only while falling)
    cov::hit(291); let old_bottom = py + PLAYER_H;
    cov::hit(292); px = (px + vx * dt).max(FX).min(FX + FW - PLAYER_W);
    cov::hit(293); py = py + vy * dt;
    cov::hit(294); grounded = false;
    cov::hit(295); for s in cov::pass(296, solids()) {
        cov::hit(297); let top = cov::pass(298, s.y) * 1.0px;
        cov::hit(299); let sx = cov::pass(300, s.x) * 1.0px; cov::hit(301); let sw = cov::pass(302, s.w) * 1.0px;
        cov::hit(303); if cov::dec(24, cov::begin(24) && (cov::cmp(24, 0, 3, cov::lhs(vy) >= cov::rhs(0.0px/s)) && cov::cmp(24, 1, 5, cov::lhs(old_bottom) <= cov::rhs(top + 1.0px)) && cov::cmp(24, 2, 2, cov::lhs(px + PLAYER_W) > cov::rhs(sx)) && cov::cmp(24, 3, 4, cov::lhs(px) < cov::rhs(sx + sw)) && cov::cmp(24, 4, 3, cov::lhs(py + PLAYER_H) >= cov::rhs(top)) && cov::cmp(24, 5, 5, cov::lhs(py + PLAYER_H) <= cov::rhs(top + 24.0px)))) {
            cov::hit(304); py = top - PLAYER_H; cov::hit(305); vy = 0.0px/s; cov::hit(306); grounded = true;
        }
    }
    cov::hit(307); if cov::dec(25, cov::begin(25) && (cov::cmp(25, 0, 2, cov::lhs(py) > cov::rhs(FY + FH + 200.0px)))) {
        // fell out of the world — respawn
        cov::hit(308); music::sfx(cov::pass(309, sfxDie()));
        cov::hit(310); let s0 = cov::pass(311, spawn_row())!;
        cov::hit(312); return W { px = cov::pass(313, cov::pass(314, s0.x) * 1.0px), py = cov::pass(315, cov::pass(316, s0.y) * 1.0px), vx = cov::pass(317, 0.0px/s),
                   vy = cov::pass(318, 0.0px/s), face = cov::pass(319, 1.0), grounded = cov::pass(320, false),
                   got = cov::pass(321, cov::pass(322, w.got)), score = cov::pass(323, cov::pass(324, w.score)), deaths = cov::pass(325, cov::pass(326, w.deaths) + 1),
                   won = cov::pass(327, cov::pass(328, w.won)), t = cov::pass(329, t) };
    }

    // hazards — goombas patrol their row's span, lava just burns
    cov::hit(330); for h in cov::pass(331, level()) {
        cov::hit(332); if cov::dec(26, cov::begin(26) && (cov::cmp(26, 0, 0, cov::lhs(cov::pass(333, h.kind)) == cov::rhs("goomba")) || cov::cmp(26, 1, 0, cov::lhs(cov::pass(334, h.kind)) == cov::rhs("lava")))) {
            cov::hit(335); let hx = cov::pass(336, h.x) * 1.0px; cov::hit(337); let hy = cov::pass(338, h.y) * 1.0px;
            cov::hit(339); let hw = cov::pass(340, h.w) * 1.0px; cov::hit(341); let hh = cov::pass(342, h.h) * 1.0px;
            cov::hit(343); let ox = if cov::dec(27, cov::begin(27) && (cov::cmp(27, 0, 0, cov::lhs(cov::pass(344, h.kind)) == cov::rhs("goomba")))) {
                cov::hit(345); let span = (hw - 24.0px).max(0.0px);
                cov::hit(346); let ph = (t.to("s") * 60.0 / span.to("px").max(1.0)) mod 2.0;
                cov::hit(347); hx + (if cov::dec(28, cov::begin(28) && (cov::cmp(28, 0, 4, cov::lhs(ph) < cov::rhs(1.0)))) { cov::hit(348); ph } else { cov::hit(349); 2.0 - ph }) * span
            } else { cov::hit(350); hx };
            cov::hit(351); let ow = if cov::dec(29, cov::begin(29) && (cov::cmp(29, 0, 0, cov::lhs(cov::pass(352, h.kind)) == cov::rhs("goomba")))) { cov::hit(353); 24.0px } else { cov::hit(354); hw };
            cov::hit(355); let mhh = if cov::dec(30, cov::begin(30) && (cov::cmp(30, 0, 0, cov::lhs(cov::pass(356, h.kind)) == cov::rhs("goomba")))) { cov::hit(357); 24.0px } else { cov::hit(358); hh };
            cov::hit(359); if cov::dec(31, cov::begin(31) && (cov::cmp(31, 0, 2, cov::lhs(px + PLAYER_W) > cov::rhs(ox)) && cov::cmp(31, 1, 4, cov::lhs(px) < cov::rhs(ox + ow)) && cov::cmp(31, 2, 2, cov::lhs(py + PLAYER_H) > cov::rhs(hy)) && cov::cmp(31, 3, 4, cov::lhs(py) < cov::rhs(hy + mhh)))) {
                cov::hit(360); music::sfx(cov::pass(361, sfxDie()));
                cov::hit(362); let s0 = cov::pass(363, spawn_row())!;
                cov::hit(364); return W { px = cov::pass(365, cov::pass(366, s0.x) * 1.0px), py = cov::pass(367, cov::pass(368, s0.y) * 1.0px), vx = cov::pass(369, 0.0px/s),
                           vy = cov::pass(370, 0.0px/s), face = cov::pass(371, 1.0), grounded = cov::pass(372, false),
                           got = cov::pass(373, cov::pass(374, w.got)), score = cov::pass(375, cov::pass(376, w.score)), deaths = cov::pass(377, cov::pass(378, w.deaths) + 1),
                           won = cov::pass(379, cov::pass(380, w.won)), t = cov::pass(381, t) };
            }
        }
    }

    // coins
    cov::hit(382); let got = cov::pass(383, w.got);
    cov::hit(384); let score = cov::pass(385, w.score);
    cov::hit(386); for c in cov::pass(387, coins()) {
        cov::hit(388); if cov::dec(32, cov::begin(32) && (cov::cond(32, 0, !cov::pass(389, got.contains(cov::pass(390, c.id)))))) {
            cov::hit(391); let dx = (px + PLAYER_W / 2.0 - (cov::pass(392, c.x) + cov::pass(393, c.w) / 2.0) * 1.0px).abs();
            cov::hit(394); let dy = (py + PLAYER_H / 2.0 - (cov::pass(395, c.y) + cov::pass(396, c.h) / 2.0) * 1.0px).abs();
            cov::hit(397); if cov::dec(33, cov::begin(33) && (cov::cmp(33, 0, 4, cov::lhs(dx) < cov::rhs(PICK * 1.0px + 8.0px)) && cov::cmp(33, 1, 4, cov::lhs(dy) < cov::rhs(PICK * 1.0px + 14.0px)))) {
                cov::hit(398); got.push(cov::pass(399, c.id)); cov::hit(400); score += 1;
                cov::hit(401); music::sfx(cov::pass(402, sfxCoin()));
            }
        }
    }

    // the flag — only counts once every coin is pocketed
    cov::hit(403); let won = cov::pass(404, w.won);
    cov::hit(405); if cov::dec(34, cov::begin(34) && (cov::cond(34, 0, !won) && cov::cmp(34, 1, 0, cov::lhs(score) == cov::rhs(cov::pass(406, coins()).len())))) {
        cov::hit(407); let g = cov::pass(408, goal_row())!;
        cov::hit(409); let gx = cov::pass(410, g.x) * 1.0px; cov::hit(411); let gy = cov::pass(412, g.y) * 1.0px;
        cov::hit(413); let gw = cov::pass(414, g.w) * 1.0px; cov::hit(415); let gh = cov::pass(416, g.h) * 1.0px;
        cov::hit(417); if cov::dec(35, cov::begin(35) && (cov::cmp(35, 0, 2, cov::lhs(px + PLAYER_W) > cov::rhs(gx)) && cov::cmp(35, 1, 4, cov::lhs(px) < cov::rhs(gx + gw)) && cov::cmp(35, 2, 2, cov::lhs(py + PLAYER_H) > cov::rhs(gy)) && cov::cmp(35, 3, 4, cov::lhs(py) < cov::rhs(gy + gh)))) {
            cov::hit(418); won = true; cov::hit(419); music::sfx(cov::pass(420, sfxWin()));
        }
    }

    cov::hit(421); W { px = cov::pass(422, px), py = cov::pass(423, py), vx = cov::pass(424, vx), vy = cov::pass(425, vy), face = cov::pass(426, face),
        grounded = cov::pass(427, grounded), got = cov::pass(428, got), score = cov::pass(429, score), deaths = cov::pass(430, cov::pass(431, w.deaths)),
        won = cov::pass(432, won), t = cov::pass(433, t) }
}

// §follow-cam ----------------------------------------------------------
// The field is bigger than a screenful — `game::cam` centres the camera
// on the player at ZOOM× for every world draw after it, clamped so the
// view never leaves the field. `game::text` is screen-space, so the HUD
// stays pinned; `cam_reset` would free field-space HUD geometry anyway.
const ZOOM = 2.2;

fn follow(px: px, py: px) {
    // half the 1280×720 view, in world px, at this zoom
    cov::hit(434); let hw = 640.0px / ZOOM;
    cov::hit(435); let hh = 360.0px / ZOOM;
    cov::hit(436); game::cam(
        px.max(FX + hw).min(FX + FW - hw),
        py.max(FY + hh).min(FY + FH - hh),
        ZOOM,
    );
}

fn draw(w: W) {
    cov::hit(437); cov::pass(438, follow(cov::pass(439, w.px) + PLAYER_W / 2.0, cov::pass(440, w.py) + PLAYER_H / 2.0));
    cov::hit(441); game::rect(FX, FY, FW, FH, "#0a0f1e", "#31506b", 3.0px);
    cov::hit(442); game::tile("clouds", FX, FY, FW, FH * 0.4, 220.0px);
    cov::hit(443); for r in cov::pass(444, level()) {
        cov::hit(445); let x = cov::pass(446, r.x) * 1.0px; cov::hit(447); let y = cov::pass(448, r.y) * 1.0px;
        cov::hit(449); let wd = cov::pass(450, r.w) * 1.0px; cov::hit(451); let ht = cov::pass(452, r.h) * 1.0px;
        cov::hit(453); if cov::dec(36, cov::begin(36) && (cov::cmp(36, 0, 0, cov::lhs(cov::pass(454, r.kind)) == cov::rhs("ground")))) {
            cov::hit(455); game::rect(x, y, wd, ht, "#3b2f23", "#6b5335", 2.0px);
        } else if cov::dec(37, cov::begin(37) && (cov::cmp(37, 0, 0, cov::lhs(cov::pass(456, r.kind)) == cov::rhs("plat")))) {
            cov::hit(457); game::sprite("block", x, y, wd, ht, 0.0);
        } else if cov::dec(38, cov::begin(38) && (cov::cmp(38, 0, 0, cov::lhs(cov::pass(458, r.kind)) == cov::rhs("coin")))) {
            cov::hit(459); if cov::dec(39, cov::begin(39) && (cov::cond(39, 0, !cov::pass(460, w.got.contains(cov::pass(461, r.id)))))) {
                cov::hit(462); game::sprite("coin", x, y, wd, ht, 0.0);
            }
        } else if cov::dec(40, cov::begin(40) && (cov::cmp(40, 0, 0, cov::lhs(cov::pass(463, r.kind)) == cov::rhs("lava")))) {
            cov::hit(464); game::rect(x, y, wd, ht, "#e03e1a", "#ff8c42", 2.0px);
        } else if cov::dec(41, cov::begin(41) && (cov::cmp(41, 0, 0, cov::lhs(cov::pass(465, r.kind)) == cov::rhs("goomba")))) {
            cov::hit(466); let span = (wd - 24.0px).max(0.0px);
            cov::hit(467); let ph = (w.t.to("s") * 60.0 / span.to("px").max(1.0)) mod 2.0;
            cov::hit(468); let gx = x + (if cov::dec(42, cov::begin(42) && (cov::cmp(42, 0, 4, cov::lhs(ph) < cov::rhs(1.0)))) { cov::hit(469); ph } else { cov::hit(470); 2.0 - ph }) * span;
            cov::hit(471); game::sprite("goomba", gx, y, 24.0px, 24.0px, 0.0);
        } else if cov::dec(43, cov::begin(43) && (cov::cmp(43, 0, 0, cov::lhs(cov::pass(472, r.kind)) == cov::rhs("goal")))) {
            cov::hit(473); game::sprite("flag", x, y, wd.max(48.0px), ht.max(64.0px), 0.0);
        }
    }
    cov::hit(474); game::sprite("mimo", cov::pass(475, w.px) - 6.0px, cov::pass(476, w.py) - 4.0px, 36.0px, 44.0px, cov::pass(477, w.face) * 6deg);
    cov::hit(478); game::cam_reset();
    cov::hit(479); let sc = cov::pass(480, w.score); cov::hit(481); let dn = cov::pass(482, w.deaths);
    cov::hit(483); game::text(60.0px, 62.0px, f"◉ {sc}/{cov::pass(484, coins()).len()}", 22.0px, G_GOLD);
    cov::hit(485); game::text(860.0px, 62.0px, f"✗ {dn}", 22.0px, G_DIM);
    cov::hit(486); game::ctext(520.0px, FY + FH + 26.0px,
        "← → run   ·   ↑ jump   ·   r restart   ·   the level is the table — edit it",
        20.0px, G_DIM);
    cov::hit(487); if cov::dec(44, cov::begin(44) && (cov::cond(44, 0, cov::pass(488, w.won)))) {
        cov::hit(489); game::ctext(520.0px, 380.0px, f"★ you cleared it — {sc}/{cov::pass(490, coins()).len()} ★",
            42.0px, G_GOLD);
    }
}

// §asset panels ---------------------------------------------------------
// Each `live_<name>` is the vector base of `game::sprite("<name>")` —
// and the [[#]] sprite cell of the same name frames it on the canvas,
// so ink drawn there bakes into every stamp. A little sprite sheet.
